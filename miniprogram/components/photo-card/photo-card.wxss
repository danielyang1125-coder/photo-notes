.photo-card {
  break-inside: avoid;
  margin-bottom: 16rpx;
  border-radius: 16rpx; /* 8pt */
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08); /* 0 1pt 3pt */
  position: relative;
}

.image-wrap {
  position: relative;
  width: 100%;
  background: #e9e9e9;
}

.card-image {
  width: 100%;
  height: 100%;
  display: block;
}

.image-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #aaa;
  font-size: 22rpx;
}
/* 卡片底部信息容器 — 绝对定位，flex 列布局 */
.card-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
  pointer-events: none;
}

/* 标签徽标 — 备注蒙层上方 12rpx */
.tag-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  font-size: 22rpx;
  line-height: 1.4;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  pointer-events: auto;
}
.tag-badge-count {
  font-size: 20rpx;
  line-height: 1;
}

/* 备注内容蒙层 — 全宽，灰色半透明背景，白色文字，最多两行 */
.note-overlay {
  width: 100%;
  padding: 12rpx 16rpx;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  pointer-events: auto;
}
.note-overlay-text {
  color: #fff;
  font-size: 24rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
