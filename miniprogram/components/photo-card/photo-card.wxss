.photo-card {
  break-inside: avoid;
  margin-bottom: 16rpx;
  border-radius: var(--radius-card, 16rpx);
  overflow: hidden;
  background: var(--color-surface-base, #fff);
  position: relative;
}
.image-wrap {
  position: relative;
  width: 100%;
  background: #e9e9e9;
}
.card-image {
  width: 100%;
  height: 100%;
  display: block;
}
.image-placeholder {
  display:flex;
  width:100%;
  height:100%;
  align-items:center;
  justify-content:center;
  color:#aaa;
  font-size:22rpx;
}
.note-mark {
  position:absolute;
  right:12rpx;
  bottom:12rpx;
  display: flex;
  align-items: center;
  justify-content:center;
  gap:6rpx;
  min-width:48rpx;
  height:48rpx;
  padding:0 12rpx;
  box-sizing:border-box;
  border-radius:24rpx;
  color:#fff;
  background:rgba(0,0,0,.62);
}
.note-count { font-size:22rpx; line-height:1; }
