<!-- 瀑布流图片卡片 -->
<view class="photo-card" bind:tap="handleTap" role="button" aria-label="查看图片详情">
  <view class="image-wrap" style="height: {{cardHeight}}rpx">
    <image
      wx:if="{{!imageError && photo.thumbnail_url}}"
      src="{{photo.thumbnail_url}}"
      mode="aspectFill"
      lazy-load
      class="card-image"
      binderror="handleImageError"
    />
    <view wx:else class="image-placeholder">
      <text>图片加载失败</text>
    </view>
    <!-- 底部信息区：标签徽标 + 备注蒙层 -->
    <view class="card-footer" wx:if="{{photo.tag_count > 0 || photo.latest_note_content}}">
      <!-- 标签提示 -->
      <view class="tag-badge" wx:if="{{photo.tag_count > 0}}">
        <t-icon name="discount" size="24rpx" />
        <text class="tag-badge-count">{{photo.tag_count}}</text>
      </view>
      <!-- 备注蒙层 -->
      <view class="note-overlay" wx:if="{{photo.latest_note_content}}">
        <text class="note-overlay-text">{{photo.latest_note_content}}</text>
      </view>
    </view>
  </view>
</view>
