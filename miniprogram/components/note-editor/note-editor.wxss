.mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex; align-items: flex-end;
  animation: maskFadeIn 0.3s ease;
}
@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.editor {
  width: 100%; background: var(--color-surface-base, #fff);
  border-radius: var(--radius-lg, 32rpx) var(--radius-lg, 32rpx) 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: slideUp 0.3s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.editor-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx;
  min-height: 104rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--color-border, #E8E8E8);
}
.title { font-size: var(--font-size-lg, 32rpx); font-weight: 700; color: var(--color-text-primary); }
.cancel-btn { font-size: var(--font-size-md, 28rpx); color: var(--color-text-secondary); }
.confirm-btn { font-size: var(--font-size-md, 28rpx); color: var(--color-primary); font-weight: 600; }
.confirm-btn.disabled { color: var(--color-text-placeholder); }
.editor-body { padding: 32rpx; }
.textarea {
  width: 100%; min-height: 200rpx; font-size: var(--font-size-md, 28rpx);
  line-height: 1.6; color: var(--color-text-primary);
}
.char-count {
  margin-top: 16rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-placeholder);
  text-align: right;
}
.error { margin-top: 16rpx; font-size: var(--font-size-sm, 24rpx); color: var(--color-error); }
