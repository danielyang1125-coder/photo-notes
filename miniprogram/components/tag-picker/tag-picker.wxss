.mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex; align-items: flex-end;
}
.picker {
  width: 100%; max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex; flex-direction: column;
}
.picker-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.title { font-size: 32rpx; font-weight: 600; color: #333; }
.cancel-btn { font-size: 28rpx; color: #999; }
.save-btn { font-size: 28rpx; color: #0052D9; font-weight: 600; }
.save-btn.disabled { color: #bbb; }
.picker-body {
  flex: 1; overflow-y: auto;
  padding: 16rpx 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  margin-bottom: 16rpx;
  flex-shrink: 0;
}
.search-input-wrap {
  display: flex; align-items: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}
.search-icon {
  font-size: 28rpx; margin-right: 12rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx; color: #333;
  min-height: 40rpx;
}
.clear-btn {
  font-size: 28rpx; color: #999;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

/* ---------- 创建入口 ---------- */
.create-entry {
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #e8f5e9;
  border: 1rpx dashed #4caf50;
  margin-bottom: 16rpx;
}
.create-icon {
  font-size: 28rpx; font-weight: 700; color: #4caf50;
  margin-right: 12rpx;
}
.create-label {
  font-size: 28rpx; color: #2e7d32;
}
.create-only {
  padding: 40rpx 0;
}

/* ---------- 状态 ---------- */
.loading, .empty { padding: 60rpx 0; text-align: center; font-size: 28rpx; color: #999; }

/* ---------- 标签列表 ---------- */
.tag-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag-item {
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 28rpx; color: #333;
  position: relative;
}
.tag-item.selected { background: #e8f0fe; color: #0052D9; }
.tag-name { max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tag-count { margin-left: 8rpx; font-size: 22rpx; color: #999; }
.tag-item.selected .tag-count { color: #0052D9; }
.check-mark { margin-left: 8rpx; font-size: 24rpx; font-weight: 700; }
