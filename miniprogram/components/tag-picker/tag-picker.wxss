.mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex; align-items: flex-end;
  animation: maskFadeIn 0.3s ease;
}
@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.picker {
  width: 100%; max-height: 70vh;
  background: var(--color-surface-base, #fff);
  border-radius: var(--radius-lg, 32rpx) var(--radius-lg, 32rpx) 0 0;
  display: flex; flex-direction: column;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.picker-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx;
  min-height: 104rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--color-border, #E8E8E8);
  flex-shrink: 0;
}
.title { font-size: var(--font-size-lg, 32rpx); font-weight: 700; color: var(--color-text-primary); }
.cancel-btn { font-size: var(--font-size-md, 28rpx); color: var(--color-text-secondary); }
.save-btn { font-size: var(--font-size-md, 28rpx); color: var(--color-primary); font-weight: 600; }
.save-btn.disabled { color: var(--color-text-placeholder); }
.picker-body {
  flex: 1; overflow-y: auto;
  padding: 16rpx 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  margin-bottom: 16rpx;
  flex-shrink: 0;
}
.search-input-wrap {
  display: flex; align-items: center;
  background: var(--color-surface-secondary, #F3F3F3);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}
.search-icon {
  font-size: 28rpx; margin-right: 12rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: var(--font-size-md, 28rpx); color: var(--color-text-primary);
  min-height: 40rpx;
}
.clear-btn {
  font-size: 28rpx; color: var(--color-text-placeholder);
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

/* ---------- 创建入口（虚线边框） ---------- */
.create-entry {
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md, 12rpx);
  border: 1px dashed var(--color-border);
  margin-bottom: 16rpx;
}
.create-icon {
  font-size: 28rpx; font-weight: 700; color: var(--color-primary);
  margin-right: 12rpx;
}
.create-label {
  font-size: var(--font-size-md, 28rpx); color: var(--color-primary);
}
.create-only {
  padding: 40rpx 0;
}

/* ---------- 状态 ---------- */
.loading, .empty { padding: 60rpx 0; text-align: center; font-size: 28rpx; color: var(--color-text-placeholder); }

/* ---------- 标签列表 ---------- */
.tag-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag-item {
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-tag, 28rpx);
  background: var(--color-surface-base);
  border: 1px solid var(--color-border);
  font-size: var(--font-size-md, 28rpx); color: var(--color-text-primary);
  position: relative;
  transition: all 0.2s ease;
}
.tag-item.selected {
  background: var(--color-tag-selected-bg);
  color: var(--color-primary);
  border-color: transparent;
}
.tag-name { max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tag-count { margin-left: 8rpx; font-size: var(--font-size-xs, 22rpx); color: var(--color-text-placeholder); }
.tag-item.selected .tag-count { color: var(--color-primary); }
.check-mark { margin-left: 8rpx; font-size: 24rpx; font-weight: 700; }
