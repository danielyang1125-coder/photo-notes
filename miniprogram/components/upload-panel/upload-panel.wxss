.panel {
  background: var(--color-surface-base, #fff);
  border-radius: var(--radius-lg, 32rpx) var(--radius-lg, 32rpx) 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  animation: panelSlideUp 0.3s ease;
}
@keyframes panelSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* ---- Header ---- */
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 16rpx;
  flex-shrink: 0;
}
.title { font-size: var(--font-size-lg, 32rpx); font-weight: 600; color: var(--color-text-primary); }
.continue-btn { font-size: var(--font-size-md, 28rpx); color: var(--color-primary); }

/* ---- 4列网格 ---- */
.task-grid { flex: 1; padding: 0 32rpx; max-height: 50vh; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.grid-item {
  width: calc((100% - 48rpx) / 4);
  aspect-ratio: 1;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}
.grid-thumb {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.grid-thumb.placeholder {
  background: var(--color-surface-secondary);
  border: 1rpx dashed var(--color-border);
}

/* 状态标记 */
.grid-status {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid-status.success { background: var(--color-success); }
.grid-status.failed { background: var(--color-error); }
.grid-status.uploading { background: rgba(0, 0, 0, 0.4); }
.grid-progress { font-size: 18rpx; color: #fff; }

/* 重试遮罩 */
.grid-retry {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: var(--font-size-xs, 22rpx);
}

/* ---- 警告横幅 ---- */
.warning-banner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  margin: 0 32rpx;
  background: rgba(237, 123, 47, 0.08);
  border-radius: 8rpx;
}
.warning-text {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-warning);
}

/* ---- 批量总结 ---- */
.batch-summary {
  padding: 16rpx 32rpx 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm, 24rpx);
}

/* ---- 底部按钮 ---- */
.panel-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
}
