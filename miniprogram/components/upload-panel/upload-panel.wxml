<!-- PG-003 上传面板 -->
<t-popup visible="{{visible}}" placement="bottom" bind:visible-change="handleVisibleChange">
  <view class="panel">
    <!-- Top Bar: 已选 N/MAX + 继续选择 -->
    <view class="top-bar">
      <text class="top-bar-title">已选 {{uploadedCount}}/{{totalCount}}</text>
      <view wx:if="{{!allDone}}" class="top-bar-action" bind:tap="handleChooseImage">
        <text class="top-bar-action-label">继续选择</text>
      </view>
    </view>

    <!-- 4列网格上传项 -->
    <scroll-view class="grid-section" scroll-y>
      <view class="grid">
        <view
          wx:for="{{tasks}}"
          wx:key="id"
          class="grid-item {{item.status === 'success' ? 'is-success' : ''}} {{item.status === 'failed' ? 'is-failed' : ''}}"
        >
          <image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" class="grid-thumb" />
          <view wx:else class="grid-thumb placeholder" />

          <!-- 上传中：深色蒙层 + 居中进度 -->
          <view wx:if="{{item.status === 'uploading' || item.status === 'compressing' || item.status === 'confirming'}}" class="grid-progress-mask">
            <text class="grid-progress-text">{{item.progress || 0}}%</text>
          </view>

          <!-- 成功：右上角绿色对勾角标 -->
          <view wx:if="{{item.status === 'success'}}" class="grid-badge badge-success">
            <text class="badge-icon">✓</text>
          </view>

          <!-- 失败：右上角红色 × 角标 -->
          <view wx:elif="{{item.status === 'failed'}}" class="grid-badge badge-failed">
            <text class="badge-icon">×</text>
          </view>

          <!-- 重试遮罩（失败的） -->
          <view
            wx:if="{{item.status === 'failed' && item.canRetry !== false}}"
            class="grid-retry"
            data-id="{{item.id}}"
            bind:tap="handleRetryTask"
          >
            <text>重试</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 失败警告横幅 -->
    <view wx:if="{{failedCount > 0}}" class="fail-notice">
      <view class="warn-icon">
        <text class="warn-glyph">!</text>
      </view>
      <text class="notice-text">{{failedCount}} 张图片上传失败：{{errorHint}}</text>
    </view>

    <!-- 结果摘要 + 添加标签按钮 -->
    <view wx:if="{{successCount > 0 || failedCount > 0}}" class="result-section">
      <!-- 为本批图片添加标签 -->
      <view
        wx:if="{{successCount > 0}}"
        class="add-tag-btn {{allDone ? '' : 'is-disabled'}}"
        bind:tap="handleAddTags"
      >
        <text class="add-tag-label">批量添加标签</text>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="panel-actions">
      <t-button
        wx:if="{{!allDone}}"
        theme="primary"
        size="large"
        block
        bind:tap="handleChooseImage"
      >选择图片（最多{{maxCount}}张）</t-button>
      <t-button
        wx:if="{{allDone && successCount > 0}}"
        theme="primary"
        size="large"
        block
        bind:tap="handleDone"
      >完成</t-button>
      <t-button
        wx:if="{{allDone && successCount === 0}}"
        theme="default"
        size="large"
        block
        bind:tap="handleCloseCompleted"
      >关闭</t-button>
      <t-button
        wx:if="{{hasActive}}"
        theme="default"
        size="large"
        block
        bind:tap="handleCancel"
      >取消上传</t-button>
    </view>
  </view>

  <!-- 离开确认 -->
  <t-dialog
    visible="{{showLeaveConfirm}}"
    title="确认离开"
    content="还有未完成的上传任务，离开将取消正在上传的任务。已上传成功的图片不会丢失。"
    confirm-btn="确认离开"
    cancel-btn="继续上传"
    bind:confirm="handleConfirmLeave"
    bind:cancel="handleCancelLeave"
  />
  <!-- 标签选择器（批量模式） -->
  <tag-picker
    photoIds="{{batchPhotoIds}}"
    visible="{{showTagPicker}}"
    bind:close="handleTagPickerClose"
    bind:confirm="handleTagPickerConfirm"
  />
</t-popup>