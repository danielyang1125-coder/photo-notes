<!-- PG-003 上传面板 -->
<t-popup visible="{{visible}}" placement="bottom" bind:visible-change="handleVisibleChange">
  <view class="panel">
    <!-- Header -->
    <view class="panel-header">
      <text class="title">已选 {{uploadedCount}}/{{totalCount}}</text>
      <text wx:if="{{!allDone}}" class="continue-btn" bind:tap="handleChooseImage">继续选择</text>
    </view>

    <!-- 4列网格上传项 -->
    <scroll-view class="task-grid" scroll-y>
      <view class="grid">
        <view wx:for="{{tasks}}" wx:key="id" class="grid-item">
          <image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" class="grid-thumb" />
          <view wx:else class="grid-thumb placeholder" />
          <!-- 状态标记 -->
          <view wx:if="{{item.status === 'success'}}" class="grid-status success">
            <t-icon name="check" size="24rpx" color="#fff" />
          </view>
          <view wx:elif="{{item.status === 'failed'}}" class="grid-status failed">
            <t-icon name="close" size="24rpx" color="#fff" />
          </view>
          <view wx:elif="{{item.status === 'uploading' || item.status === 'compressing' || item.status === 'confirming'}}" class="grid-status uploading">
            <text class="grid-progress">{{item.progress || ''}}</text>
          </view>
          <!-- 重试按钮（失败的） -->
          <view
            wx:if="{{item.status === 'failed' && item.canRetry !== false}}"
            class="grid-retry"
            data-id="{{item.id}}"
            bind:tap="handleRetryTask"
          >
            <text>重试</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 警告横幅 -->
    <view wx:if="{{failedCount > 0}}" class="warning-banner">
      <t-icon name="error-circle" size="28rpx" color="#ED7B2F" />
      <text class="warning-text">{{failedCount}} 张图片上传失败</text>
    </view>

    <!-- 批量标签按钮 - 始终可见 -->
    <view wx:if="{{allDone && successCount > 0}}" class="batch-summary">
      上传完成：成功 {{successCount}} 张，失败 {{failedCount}} 张
    </view>

    <!-- 操作按钮 -->
    <view class="panel-footer">
      <t-button wx:if="{{!allDone}}" theme="primary" size="large" block bind:tap="handleChooseImage">
        选择图片（最多{{maxCount}}张）
      </t-button>
      <t-button wx:if="{{allDone && successCount > 0}}" theme="primary" size="large" block bind:tap="handleDone">
        完成
      </t-button>
      <t-button
        wx:if="{{successCount > 0}}"
        theme="default"
        size="large"
        block
        disabled="{{allDone ? false : true}}"
        bind:tap="handleAddTags"
      >为本批图片添加标签</t-button>
      <t-button wx:if="{{allDone && successCount === 0}}" theme="default" size="large" block bind:tap="handleCloseCompleted">
        关闭
      </t-button>
      <t-button wx:if="{{hasActive}}" theme="default" size="large" block bind:tap="handleCancel">
        取消上传
      </t-button>
    </view>
  </view>

  <!-- 离开确认 -->
  <t-dialog
    visible="{{showLeaveConfirm}}"
    title="确认离开"
    content="还有未完成的上传任务，离开将取消正在上传的任务。已上传成功的图片不会丢失。"
    confirm-btn="确认离开"
    cancel-btn="继续上传"
    bind:confirm="handleConfirmLeave"
    bind:cancel="handleCancelLeave"
  />
  <!-- 标签选择器（批量模式） -->
  <tag-picker
    photoIds="{{batchPhotoIds}}"
    visible="{{showTagPicker}}"
    bind:close="handleTagPickerClose"
    bind:confirm="handleTagPickerConfirm"
  />
</t-popup>
