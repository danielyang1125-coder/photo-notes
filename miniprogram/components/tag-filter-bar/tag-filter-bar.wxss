/* 标签筛选栏：高 44pt = 88rpx */
.filter-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.filter-scroll {
  flex: 1;
  width: 0;
  white-space: nowrap;
}

.filter-tags {
  display: inline-flex;
  gap: 16rpx;               /* 标签间距 8pt */
  flex-wrap: nowrap;
  align-items: center;
}

/* 自定义标签：高 28pt 圆角 14pt */
.tag-chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;            /* 28pt */
  padding: 0 24rpx;
  border-radius: 28rpx;     /* 14pt */
  font-size: 26rpx;         /* 13pt */
  line-height: 56rpx;
  flex-shrink: 0;
  white-space: nowrap;
  transition: background 0.2s ease, color 0.2s ease;
}

/* 未选中态：背景 #F2F3F5 文字 #181818 */
.tag-chip {
  background: #F2F3F5;
  color: #181818;
}

/* 选中态：背景 #0052D9 文字白色 */
.tag-chip.active {
  background: #0052D9;
  color: #FFFFFF;
}

.filter-actions {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.action {
  font-size: 26rpx;
  color: #0052D9;
  padding: 8rpx 8rpx;
  white-space: nowrap;
}

.tag-name {
  display: block;
  max-width: 168rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-skeleton {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.skeleton-pill {
  width: 112rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #f2f2f2 25%, #fafafa 37%, #f2f2f2 63%);
  background-size: 400% 100%;
  animation: tag-shimmer 1.2s ease infinite;
}

.skeleton-pill.short {
  width: 72rpx;
}

.tag-error {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #999;
  font-size: 22rpx;
  white-space: nowrap;
}

.tag-error .retry {
  color: #0052D9;
  padding: 10rpx 0;
}

@keyframes tag-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
