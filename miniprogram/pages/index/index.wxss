.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: var(--color-surface-base, #FFFFFF);
}

/* ---- 启动视觉层 ---- */
.splash {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.splash-logo {
  width: 240rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-light, #E7F0FF);
  border-radius: 32rpx;
}
.splash-title {
  font-size: 40rpx; /* h1: 20pt → 40rpx */
  font-weight: 700;
  color: var(--color-text-primary, #181818);
  letter-spacing: 4rpx;
}
.splash-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}
.splash-version {
  font-size: var(--font-size-sm, 24rpx); /* caption: 12pt → 24rpx */
  color: var(--color-text-placeholder, #A6A6A6);
  margin-top: 8rpx;
}
