.page {
  min-height: 100vh;
  background: var(--color-surface-secondary, #f3f3f3);
}
.content {
  padding: 0;
}

/* ---- Section Group ---- */
.section-group {
  margin-bottom: 32rpx;
}
.section-group-title {
  display: block;
  padding: 24rpx 32rpx 12rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-secondary);
}

/* ---- Storage Card ---- */
.storage-card {
  margin: 0 32rpx;
  padding: 24rpx;
  background: var(--color-surface-base);
  border-radius: var(--radius-card, 16rpx);
  border: 1px solid var(--color-border);
}
.storage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.storage-label {
  font-size: var(--font-size-md, 28rpx);
  color: var(--color-text-primary);
}
.storage-value {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-secondary);
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
}

/* ---- Settings Item ---- */
.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx;
  padding: 24rpx;
  background: var(--color-surface-base);
  border-radius: var(--radius-card, 16rpx);
  border: 1px solid var(--color-border);
}
.settings-item--hover {
  background: var(--color-surface-secondary);
}
.settings-item-title {
  font-size: var(--font-size-md, 28rpx);
  color: var(--color-text-primary);
}
.settings-item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.settings-item-note {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-placeholder);
}
.settings-item-note.danger {
  color: var(--color-error, #d54941);
}
