.page { min-height:100vh; background: var(--color-overlay-ink, #101114); display:flex; flex-direction:column; }
.content { flex:1; }

/* ===== 大图区域 ===== */
.image-area {
  width: 100%;
  cursor: pointer;
  position: relative;
  transition: transform 0.15s ease-out;
}
.image-area.swiping { transition: none; }
.preview-image { width: 100%; display: block; }

/* 滑动切换 loading 蒙层（保留旧图 + 半透明 loading） */
.swipe-loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 17, 20, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* 位置指示器 */
.swipe-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}
.swipe-indicator text {
  color: #fff;
  font-size: 22rpx;
  line-height: 1.6;
}

/* ===== 底部内容卡片 ===== */
.detail-card {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -24rpx;
  position: relative;
  z-index: 5;
  padding-top: 8rpx;
}

/* 日期行 */
.detail-date-row {
  padding: 24rpx 32rpx 0;
}
.detail-date {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary, #181818);
  line-height: 1.3;
}

/* 内容区块 */
.detail-section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border, #F0F0F0);
}
.detail-section:last-child { border-bottom: none; }
.detail-section--action {
  border-bottom: none;
  padding-top: 8rpx;
}
.detail-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #181818);
  margin-bottom: 16rpx;
  display: block;
}

/* 标签区（透传 phototag-section 内部样式） */
.detail-section photo-tag-section { display: block; }

/* ===== 备注 ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #181818);
}
.empty-notes {
  color: var(--color-text-placeholder, #A6A6A6);
  font-size: 26rpx;
  text-align: center;
  padding: 32rpx 0;
}
.note-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border, #F0F0F0);
}
.note-item:last-child { border-bottom: none; }
.note-content {
  font-size: 28rpx;
  color: var(--color-text-primary, #181818);
  line-height: 1.6;
  word-break: break-all;
}
.note-meta { display: flex; gap: 16rpx; margin-top: 8rpx; }
.note-time { font-size: 24rpx; color: var(--color-text-placeholder, #A6A6A6); }
.note-edited {
  font-size: 22rpx;
  color: var(--color-warning, #ED7B2F);
  background: rgba(237, 123, 47, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

/* ===== 图片信息 ===== */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}
.info-row + .info-row { border-top: 1rpx solid var(--color-border, #F5F5F5); }
.info-label { font-size: 26rpx; color: var(--color-text-secondary, #5E5E5E); }
.info-value { font-size: 26rpx; color: var(--color-text-primary, #181818); }

/* 底部安全距离 */
.detail-bottom-safe { height: calc(32rpx + env(safe-area-inset-bottom)); }
