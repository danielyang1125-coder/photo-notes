.page { min-height:100vh; background:#000; display:flex; flex-direction:column; }
.content { flex:1; }
.image-area { width:100%; cursor:pointer; position:relative; transition: transform 0.15s ease-out; }
.image-area.swiping { transition: none; }
.preview-image { width:100%; display:block; }
/* 位置指示器 */
.swipe-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}
.swipe-indicator text {
  color: #fff;
  font-size: 22rpx;
  line-height: 1.6;
}
.section { background:#fff; padding:24rpx; margin-top:16rpx; }
.section-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16rpx; }
.section-title { font-size:30rpx; font-weight:600; }
.empty-notes { color:#ccc; font-size:26rpx; text-align:center; padding:32rpx 0; }
.note-item { padding:16rpx 0; border-bottom:1rpx solid #f0f0f0; }
.note-content { font-size:28rpx; color:#333; line-height:1.6; word-break:break-all; }
.note-meta { display:flex; gap:16rpx; margin-top:8rpx; }
.note-time { font-size:24rpx; color:#999; }
.note-edited { font-size:22rpx; color:#ED7B2F; }
.info-row { display:flex; justify-content:space-between; padding:12rpx 0; }
.info-label { font-size:26rpx; color:#999; }
.info-value { font-size:26rpx; color:#333; }
