/* ============================================================
   PG-004 图片预览详情
   基于 ardot 设计稿：375 × 910
   ============================================================ */

.page {
  min-height: 100vh;
  background: var(--color-surface-base, #ffffff);
  position: relative;
}

/* ===== 顶部固定白色导航（状态栏 + 导航栏） ===== */
.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: var(--color-surface-base, #ffffff);
  z-index: 100;
}

.nav-bar {
  height: 88rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-xl, 16rpx);
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
  cursor: pointer;
}
.nav-back--hover {
  opacity: 0.6;
}

/* 左箭头（chevron-left，纯 CSS） */
.nav-back-icon {
  width: 12rpx;
  height: 22rpx;
  position: relative;
}
.nav-back-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  border-left: 3rpx solid var(--color-text-primary, #181818);
  border-bottom: 3rpx solid var(--color-text-primary, #181818);
  transform: translate(-30%, -50%) rotate(45deg);
}

.nav-more {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-right: -12rpx;
  cursor: pointer;
}
.nav-more--hover {
  opacity: 0.6;
}
.nav-more-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-text-primary, #181818);
}

/* ===== 主内容滚动区 ===== */
.content {
  flex: 1;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 大图区域（深色底） ===== */
.image-area {
  width: 100%;
  background: var(--color-overlay-ink, #101114);
  cursor: pointer;
  position: relative;
  transition: transform 0.15s ease-out;
  overflow: hidden;
}
.image-area.swiping {
  transition: none;
}
.preview-image {
  width: 100%;
  display: block;
}

/* 滑动切换 loading 蒙层（保留旧图 + 半透明 loading） */
.swipe-loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 17, 20, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* 位置指示器 */
.swipe-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}
.swipe-indicator text {
  color: #fff;
  font-size: 22rpx;
  line-height: 1.6;
}

/* ===== 标签区（白底 + 水平滚动 chips） ===== */
.tags-section {
  margin-top: 24rpx;
  padding: var(--space-md, 12rpx) 0;
  background: var(--color-surface-base, #ffffff);
}
.tags-scroll {
  white-space: nowrap;
  width: 100%;
}
.tags-row {
  display: inline-flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: var(--space-md, 12rpx);
  padding: 0 var(--space-xl, 16rpx);
}

/* 默认 tag chip（蓝色文字 + 浅蓝背景） */
.tag-chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  background: var(--color-primary-light, #e7f0ff);
  border-radius: var(--radius-tag, 14rpx);
  flex-shrink: 0;
}
.tag-chip-text {
  font-size: 26rpx;
  color: var(--color-primary, #0052d9);
  font-family:
    'Noto Sans SC',
    -apple-system,
    BlinkMacSystemFont,
    sans-serif;
  line-height: 1.4;
  white-space: nowrap;
}

/* 编辑 chip（灰底 + 铅笔 icon） */
.tag-chip--edit {
  background: var(--color-surface-tertiary, #f2f3f5);
  gap: 8rpx;
  padding: 0 20rpx 0 24rpx;
  cursor: pointer;
}
.tag-chip--edit .tag-chip-text--edit {
  color: var(--color-primary, #0052d9);
}

/* 铅笔 icon（纯 CSS） */
.tag-chip-edit-icon {
  width: 12rpx;
  height: 12rpx;
  position: relative;
  transform: rotate(-45deg);
}
.tag-chip-edit-icon::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 9rpx;
  height: 9rpx;
  border-right: 2rpx solid var(--color-primary, #0052d9);
  border-bottom: 2rpx solid var(--color-primary, #0052d9);
  border-top: 2rpx solid transparent;
  border-left: 2rpx solid transparent;
}
.tag-chip-edit-icon::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 0;
  height: 0;
  border-left: 3rpx solid transparent;
  border-right: 3rpx solid transparent;
  border-top: 4rpx solid var(--color-primary, #0052d9);
}

/* ===== 备注区 ===== */
.notes-section {
  background: var(--color-surface-base, #ffffff);
  padding: var(--space-md, 12rpx) 0 var(--space-xl, 16rpx);
}
.notes-header {
  padding: var(--space-md, 12rpx) var(--space-xl, 16rpx) var(--space-md, 12rpx);
}
.notes-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary, #181818);
  font-family:
    'Noto Sans SC',
    -apple-system,
    BlinkMacSystemFont,
    sans-serif;
  line-height: 1.4;
}

.notes-empty {
  color: var(--color-text-placeholder, #a6a6a6);
  font-size: 26rpx;
  text-align: center;
  padding: 32rpx var(--space-xl, 16rpx);
}

/* 备注卡片 */
.note-card {
  margin: 0 var(--space-xl, 16rpx) var(--space-md, 12rpx);
  padding: 24rpx;
  background: var(--color-surface-base, #ffffff);
  border: 1rpx solid var(--color-border, #e8e8e8);
  border-radius: var(--radius-sm, 8rpx);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-content {
  font-size: 28rpx;
  color: var(--color-text-primary, #181818);
  font-family:
    'Noto Sans SC',
    -apple-system,
    BlinkMacSystemFont,
    sans-serif;
  line-height: 44rpx;
  word-break: break-all;
}

.note-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 36rpx;
}
.note-meta-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.note-time {
  font-size: 24rpx;
  color: var(--color-text-secondary, #5e5e5e);
  font-family: 'Inter', 'Noto Sans SC', sans-serif;
  line-height: 1.4;
}

/* 已编辑徽章 */
.note-edited-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 8rpx;
  background: var(--color-surface-tertiary, #f2f3f5);
  border-radius: var(--radius-xs, 4rpx);
}
.note-edited-text {
  font-size: 20rpx;
  color: var(--color-text-secondary, #5e5e5e);
  font-family: 'Noto Sans SC', sans-serif;
  line-height: 1.4;
}

/* 编辑 / 删除 文本操作 */
.note-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.note-action {
  font-size: 24rpx;
  font-family: 'Noto Sans SC', sans-serif;
  line-height: 1.4;
  padding: 8rpx 0;
}
.note-action--edit {
  color: var(--color-primary, #0052d9);
}
.note-action--delete {
  color: var(--color-error, #d54941);
}

/* ===== 底部添加备注按钮 ===== */
.add-note-wrap {
  padding: 48rpx var(--space-xl, 16rpx) var(--space-xl, 24rpx);
}
.add-note-btn {
  width: 100%;
  height: 96rpx;
  background: var(--color-primary, #0052d9);
  border-radius: var(--radius-sm, 8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  cursor: pointer;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.1);
  transition:
    opacity 0.15s ease-out,
    transform 0.15s ease-out;
}
.add-note-btn--hover {
  opacity: 0.85;
  transform: translateY(1rpx);
}

/* Plus icon（纯 CSS） */
.add-note-icon {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}
.add-note-plus-h,
.add-note-plus-v {
  position: absolute;
  background: var(--color-surface-base, #ffffff);
}
.add-note-plus-h {
  top: 50%;
  left: 0;
  right: 0;
  height: 3rpx;
  transform: translateY(-50%);
}
.add-note-plus-v {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3rpx;
  transform: translateX(-50%);
}

.add-note-label {
  color: var(--color-surface-base, #ffffff);
  font-size: 30rpx;
  font-weight: 500;
  font-family:
    'Noto Sans SC',
    -apple-system,
    BlinkMacSystemFont,
    sans-serif;
  line-height: 1.4;
}

/* 底部安全距离 */
.bottom-safe {
  height: calc(32rpx + env(safe-area-inset-bottom));
}
