<!-- PG-002 图片列表 -->
<view class="page">
  <view class="nav-fixed" style="height: {{navTotalHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner" style="height: {{navBarHeight}}px;">
      <text class="nav-title">图片</text>
    </view>
  </view>

  <view class="content" style="padding-top: {{navTotalHeight}}px;">
    <t-notice-bar
      wx:if="{{spaceWarning}}"
      visible
      content="存储空间即将用尽，请清理不需要的图片"
      theme="warning"
    />

    <tag-filter-bar
      id="tagFilterBar"
      active="{{filter.scope}}"
      activeTagId="{{filter.tagId}}"
      bind:filter="handleFilterChange"
      bind:newtag="handleNewTag"
      bind:manage="handleTagManage"
    />

    <page-state
      wx:if="{{pageState === 'initialLoading' || pageState === 'initialError' || pageState === 'empty'}}"
      state="{{pageState}}"
      skeleton-type="waterfall"
      empty-icon="image"
      empty-title="{{filter.scope === 'ALL' ? '还没有图片' : filter.scope === 'UNCATEGORIZED' ? '所有图片都已添加标签' : '这个标签下还没有图片'}}"
      empty-description="{{filter.scope === 'ALL' ? '上传第一张图片' : filter.scope === 'UNCATEGORIZED' ? '上传更多图片' : '查看全部图片'}}"
      empty-action="{{filter.scope === 'ALL' ? '上传第一张图片' : filter.scope === 'UNCATEGORIZED' ? '添加图片' : '查看全部图片'}}"
      bind:retry="handleRetry"
      bind:emptyAction="handleEmptyAction"
    />

    <scroll-view
      wx:if="{{pageState === 'ready'}}"
      class="waterfall-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-triggered="{{refresherTriggered}}"
      bindrefresherrefresh="handleRefresh"
      bindscroll="handleScroll"
      bindscrolltolower="handleLoadMore"
      lower-threshold="300"
      scroll-top="{{scrollTop}}"
      style="height: calc(100vh - {{navTotalHeight}}px - 166rpx);"
    >
      <view class="waterfall">
        <view class="column">
          <photo-card
            wx:for="{{leftList}}"
            wx:key="_id"
            photo="{{item}}"
            cardHeight="{{item._cardHeight}}"
            bind:select="handlePhotoSelect"
          />
        </view>
        <view class="column">
          <photo-card
            wx:for="{{rightList}}"
            wx:key="_id"
            photo="{{item}}"
            cardHeight="{{item._cardHeight}}"
            bind:select="handlePhotoSelect"
          />
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="load-more">加载中…</view>
      <view
        wx:elif="{{loadMoreError}}"
        class="load-more retry-more"
        role="button"
        aria-label="重试加载更多图片"
        bind:tap="handleRetryLoadMore"
      >{{loadMoreError}}</view>
      <view wx:elif="{{!hasMore && list.length > 0}}" class="load-more end">— 已显示全部 —</view>
    </scroll-view>
  </view>

  <view
    class="fab-button"
    role="button"
    aria-label="上传图片"
    bind:tap="handleOpenUpload"
  >
    <text class="fab-icon">＋</text>
  </view>

  <t-popup visible="{{showSourcePopup}}" placement="bottom" bind:visible-change="handleSourcePopupChange">
    <view class="source-popup">
      <view class="source-title">选择图片来源</view>
      <view class="source-options">
        <view class="source-option" hover-class="source-option--active" data-source="album" bind:tap="handleSourceSelect" role="button" aria-label="从相册选择">
          <view class="source-icon"><t-icon name="image" size="34rpx" /></view>
          <text>从相册选择</text>
        </view>
        <view class="source-option" hover-class="source-option--active" data-source="camera" bind:tap="handleSourceSelect" role="button" aria-label="拍照">
          <view class="source-icon"><t-icon name="camera" size="36rpx" /></view>
          <text>拍照</text>
        </view>
      </view>
      <view class="source-cancel" hover-class="source-option--active" bind:tap="handleCloseSourcePopup" role="button" aria-label="取消选择图片来源">取消</view>
    </view>
  </t-popup>

  <upload-panel
    id="uploadPanel"
    visible="{{showUpload}}"
    bind:selected="handleUploadSelected"
    bind:close="handleCloseUpload"
    bind:done="handleUploadDone"
  />
</view>
