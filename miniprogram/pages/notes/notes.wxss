.page { min-height:100vh; background: var(--color-surface-secondary, #F3F3F3); }
.content { min-height:100vh; padding-bottom: 166rpx; }
.list { padding: 16rpx 32rpx; }

/* ---- Sort Button ---- */
.sort-btn { padding: 0 8rpx !important; }
.sort-btn-inner {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-secondary, #5E5E5E);
}

/* ---- Note Card ---- */
.note-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--color-surface-base);
  border-radius: var(--radius-card, 16rpx);
  border: 1px solid var(--color-border);
  margin-bottom: 16rpx;
}
.note-card--hover { background: var(--color-surface-secondary); }
.note-card-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: var(--color-surface-secondary);
  flex-shrink: 0;
}
.note-card-thumb.placeholder { border: 1rpx dashed var(--color-border); }
.note-card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  min-width: 0;
}
.note-card-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  font-size: var(--font-size-md, 28rpx);
  color: var(--color-text-primary);
  line-height: 1.5;
}
.note-card-footer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.note-card-time {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-placeholder);
}
.note-card-edited {
  font-size: var(--font-size-xs, 22rpx);
  color: var(--color-warning);
  background: rgba(237, 123, 47, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

/* ---- Load More ---- */
.loadmore-hint { text-align: center; padding: 24rpx; font-size: 24rpx; color: #999; }
