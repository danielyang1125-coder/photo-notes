<!-- PG-008 注销处理中 -->
<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{status === 'loading'}}" class="status-wrap">
    <view class="status-spinner">
      <t-loading theme="circular" size="64rpx" />
    </view>
    <text class="status-title">正在处理注销请求…</text>
    <text class="status-desc">您的账号注销申请已提交，请耐心等待</text>
    <text class="contact-link" bind:tap="handleContact">联系客服</text>
  </view>

  <!-- 处理中 -->
  <t-result wx:elif="{{status === 'processing'}}" theme="warning" title="注销处理中" description="您的数据正在清理，请稍后查看。预计24小时内完成。">
    <t-button slot="footer" theme="default" size="medium" bind:tap="handleRefresh">刷新状态</t-button>
    <view slot="extra" class="contact-footer">
      <text class="contact-link" bind:tap="handleContact">联系客服</text>
    </view>
  </t-result>

  <!-- 完成 -->
  <t-result wx:elif="{{status === 'completed'}}" theme="success" title="注销完成" description="您的数据已清理完毕。">
    <t-button slot="footer" theme="primary" size="medium" open-type="exit">退出</t-button>
    <view slot="extra" class="contact-footer">
      <text class="contact-link" bind:tap="handleContact">联系客服</text>
    </view>
  </t-result>
</view>
