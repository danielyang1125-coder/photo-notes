/* -------- 自定义 Tab Bar 胶囊浮层 -------- */
.tab-bar-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 166rpx;  /* 83pt */
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 12rpx;
  box-sizing: border-box;
}

/* 白色胶囊容器 */
.tab-bar-pill {
  display: flex;
  width: 702rpx;   /* 351pt */
  height: 124rpx;  /* 62pt */
  background: var(--color-surface-base, #FFFFFF);
  border-radius: var(--radius-pill, 52rpx);
  box-shadow: var(--shadow-tab, 0 4rpx 16rpx rgba(0, 0, 0, 0.08));
  overflow: hidden;
}

/* 单个 Tab */
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: var(--radius-pill, 52rpx);
  transition: background 0.25s ease, color 0.25s ease;
}

/* 非激活态 */
.tab-item {
  color: var(--color-text-placeholder, #A6A6A6);
}

/* 激活态 */
.tab-item.active {
  background: var(--color-primary, #0052D9);
  color: #FFFFFF;
}

.tab-icon {
  font-size: 36rpx;  /* 18pt */
  line-height: 1;
}

.tab-label {
  font-size: var(--font-size-sm, 24rpx);
  font-weight: 500;
}
