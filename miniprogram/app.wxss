/* ============================================================
   图片笔记小程序 — 全局样式
   ============================================================ */

/* 引入主题 Token */
@import './theme/tokens.wxss';

/* 页面基础 */
page {
  background: #F3F3F3;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1D1D1D;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 全局 box-sizing */
view, text, image, scroll-view, swiper, button, input, textarea, navigator {
  box-sizing: border-box;
}

/* 按钮重置 */
button {
  background: initial;
  padding: 0;
  margin: 0;
  font-size: inherit;
  line-height: inherit;
}
button:focus { outline: 0; }
button::after { border: none; }

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
